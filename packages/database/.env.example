# Admin connection used by migrations and seeds (table owner).
DATABASE_ADMIN_URL=postgres://fa_owner:fa_owner@localhost:5432/freelancer_accounting
# Runtime connection used by the API and worker (NOT the owner, NO bypassrls — RLS applies).
DATABASE_URL=postgres://fa_runtime:fa_runtime@localhost:5432/freelancer_accounting
# Password migration 001 assigns to the fa_runtime role.
DB_RUNTIME_PASSWORD=fa_runtime
# Set to true ONLY in explicit demo environments (§54).
SEED_DEMO=false
