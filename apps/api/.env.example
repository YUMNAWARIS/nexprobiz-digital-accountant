NODE_ENV=development
PORT=8000
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:3000

# Runtime DB role (RLS applies). Migrations use packages/database/.env instead.
DATABASE_URL=postgres://fa_runtime:fa_runtime@localhost:5432/freelancer_accounting

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long

# Blob storage (DocumentStoragePort). local = filesystem under STORAGE_LOCAL_DIR; s3 = MinIO/R2.
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY_ID=fa_minio
S3_SECRET_ACCESS_KEY=fa_minio_secret
S3_FORCE_PATH_STYLE=true

# Queue (QueuePort). bullmq = Redis; inmemory = tests only.
QUEUE_DRIVER=bullmq
REDIS_URL=redis://localhost:6379
QUEUE_RECEIPT_OCR=receipt-ocr

# Story 17.5 — "Send feedback" link target
FEEDBACK_URL=mailto:feedback@example.com
